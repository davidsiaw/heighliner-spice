#!/usr/bin/env ruby
# frozen_string_literal: true

# Executable shim. Everything it does lives in spice_client/ so that it can be
# tested; see spice/docs/development.md.

# Safe only while nothing here is referenced at load time. See
# docs/development.md#loading.
Dir.glob("#{__dir__}/../wire/*.rb").each { |piece| require piece }
Dir.glob("#{__dir__}/spice_client/*.rb").each { |piece| require piece }

exit SpiceClient.main(ARGV)
